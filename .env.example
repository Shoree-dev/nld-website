# ==============================================================================
# NO LICENSED DRIVERS (NLD) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration (PostgreSQL & SSR Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Discord OAuth & App Configuration
# Set in Supabase Dashboard -> Authentication -> Providers -> Discord
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# NLD Discord Server ID (For Widget / Online Counter)
NEXT_PUBLIC_DISCORD_SERVER_ID=123456789012345678
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-nld-invite

# Admin Security (Comma-separated list of authorized Discord User IDs)
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# Discord Webhook Integration (For announcements to #announcements or #clips)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# App Base URL (Used for OAuth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
